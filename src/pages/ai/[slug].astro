---
import { getCollection, render } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import WorkflowReplay from '../../components/WorkflowReplay.astro';

export async function getStaticPaths() {
  const entries = await getCollection('ai');
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry }
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const base = import.meta.env.BASE_URL;
const series = entry.data.series
  ? (await getCollection('series')).find((item) => item.id === entry.data.series?.id)
  : undefined;
---

<SiteLayout active="ai" title={`rndyt / ${entry.data.title}`} description={entry.data.description}>
  <article class="article-shell">
    <header class="article-header">
      <div class="terminal-title"><span class="cursor" aria-hidden="true"></span> ~/notes/ai/{entry.id}</div>
      <h1>{entry.data.title}</h1>
      <p class="article-description">{entry.data.description}</p>
      <div class="article-meta">
        <span>kind={entry.data.kind}</span>
        <span>{entry.data.date.toISOString().slice(0, 10)}</span>
        <span>{entry.data.tags.map((tag: string) => `#${tag}`).join(' ')}</span>
        {series && <a href={`${base}series/${series.id}/`}>$ series/{series.id}</a>}
        <a href={`${base}ai/`}>$ cd ..</a>
      </div>
    </header>

    <div class="article-body">
      <Content />
      {entry.data.replay && <WorkflowReplay />}
    </div>
  </article>
</SiteLayout>
